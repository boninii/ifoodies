APP_NAME=iFoodies
APP_ENV=local
APP_KEY=
# EM PRODUÇÃO: APP_ENV=production e APP_DEBUG=false.
# Com debug ligado, qualquer erro devolve stack trace, caminhos de arquivo e
# trechos de configuração para quem fez a requisição.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Ignorado no Windows: PHP_CLI_SERVER_WORKERS depende de fork(), que so
# existe em sistemas POSIX. Em Linux, com --no-reload, vale a pena.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# EM PRODUÇÃO (com HTTPS): true. Sem isso o cookie de sessão do painel
# trafega sem a flag Secure e pode vazar numa conexão http.
SESSION_SECURE_COOKIE=false

# Validade do token do app, em minutos (43200 = 30 dias).
SANCTUM_EXPIRATION=43200

# Dominios de e-mail aceitos no cadastro, separados por virgula. Vazio =
# qualquer e-mail entra. Numa instalacao real de um IF, preencher aqui e a
# defesa mais eficaz contra criacao de contas em massa.
# Ex.: REGISTER_EMAIL_DOMAINS=aluno.ifsp.edu.br,ifsp.edu.br
REGISTER_EMAIL_DOMAINS=

# Origens liberadas no CORS. Em produção troque o '*' pelos domínios reais,
# separados por vírgula. O app nativo não depende disto.
CORS_ALLOWED_ORIGINS=*

# WebSocket (Laravel Reverb) — é o que faz o status do pedido chegar ao app
# no instante em que muda, sem o app ficar perguntando.
# Suba com: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AbacatePay (Pix) — API v2. As chaves atuais respondem 401 "API key version
# mismatch" nos endpoints /v1, então não volte o base_url para v1.
# Chave abc_dev_… é sandbox (devMode) e não move dinheiro real; abc_live_… é
# produção. O segredo do webhook é escolhido por você e colado no painel da
# AbacatePay, junto da URL:
#   https://SEU-DOMINIO/api/webhooks/abacatepay?webhookSecret=SEU_SEGREDO
ABACATEPAY_ENABLED=false
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
