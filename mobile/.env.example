# Em DESENVOLVIMENTO o app descobre o host da API sozinho (services/api.ts):
# web usa o hostname da página; Expo Go usa o IP do Metro. Nada a configurar.
#
# Para BUILD DE PRODUÇÃO, defina a URL pública da API. Ela é OBRIGATÓRIA:
# sem ela o app falha ao subir, de propósito. Antes existia um domínio fixo
# como reserva, e um build sem esta variável mandava e-mail e senha dos
# alunos para um endereço herdado de outro projeto.
# EXPO_PUBLIC_API_URL=https://api.seu-dominio.com.br/api/cantina

# WebSocket (Laravel Reverb) — é o que faz o status do pedido chegar na hora,
# sem o app ficar perguntando de tempos em tempos.
# A chave é a mesma do REVERB_APP_KEY em api/.env (pública, não é segredo).
# Sem ela o app continua funcionando: cai na recarga periódica.
EXPO_PUBLIC_REVERB_APP_KEY=

# Só em produção, se o WebSocket não estiver no mesmo host da API:
# EXPO_PUBLIC_REVERB_HOST=ws.seu-dominio.com.br
# EXPO_PUBLIC_REVERB_PORT=443
# EXPO_PUBLIC_REVERB_SCHEME=https
